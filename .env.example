# Backend (.env) — copy this to backend/.env and fill in values

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=finbot-uploads

# App settings
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,https://finbot.yourdomain.com
